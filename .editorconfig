# The files' encoding, line ends and indents, for editors that read it.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,md}]
indent_size = 2

# make takes a recipe's lines after a tab.
[Makefile]
indent_style = tab
