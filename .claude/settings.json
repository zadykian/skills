{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(make:*)",
      "Bash(jq:*)",
      "Bash(claude plugin validate:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)"
    ],
    "deny": [
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push * +main)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push *:refs/heads/main)",
      "Bash(git push *:refs/heads/main *)"
    ]
  },
  "plansDirectory": ".claude/plans",
  "extraKnownMarketplaces": {
    "zadykian": {
      "source": { "source": "github", "repo": "zadykian/toolkit", "ref": "v6.1.1" },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "flow@zadykian": true,
    "docs@zadykian": true,
    "lint@zadykian": true,
    "lean@zadykian": true
  }
}
