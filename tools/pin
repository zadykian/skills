#!/bin/sh
# Pins a repository's actions, marketplace and templates to one release of the toolkit:
#
#   tools/pin vX.Y.Z DIR
#
# The tag vX.Y.Z of this script's repository names the commit, SHA. In DIR's workflows, each step
# of an action of the toolkit, or of zadykian/actions before it, becomes
# `zadykian/toolkit/actions/NAME@SHA # vX.Y.Z`. A step of an action that SHA lacks, one the
# release removed, fails a check: pinned, it would fail to run. DIR's .claude/settings.json gives
# the tag as the ref of the marketplace of zadykian/toolkit, or of zadykian/skills before it.
# Dependabot cannot edit settings.json, so this moves both pins at once.
#
# DIR gets each template that SHA holds, at the path the table in templates gives it. A file of
# other text there is overwritten: the release's template is the rule, and no repository changes
# it. A release without a template, as each before v5.1.0 is, writes none, and DIR's file stays.
# No note says so, as one would come on each pin to such a release, and call for nothing.
#
# Each edit keeps its file's layout, and a second run changes nothing. Where a check fails, it
# writes nothing. Each line it changes goes to stdout, as PATH:LINE: TEXT. It needs git and jq.

set -eu

semver='(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)'
settings=.claude/settings.json
# sources is the jq path of each marketplace's source that names the toolkit's repository.
sources='.extraKnownMarketplaces[]? | .source? | objects |
    select(.repo == "zadykian/toolkit" or .repo == "zadykian/skills")'

# die prints a message of the script's and exits with status 1.
die() {
    printf 'tools/pin: %s\n' "$*" >&2
    exit 1
}

# stage keeps $tmp/out, the new text of the file $1, for main to write, where the two differ.
stage() {
    ! cmp -s "$tmp/out" "$1" || return 0
    mkdir -p "$tmp/new/${1%/*}"
    mv "$tmp/out" "$tmp/new/$1"
    printf '%s\n' "$1" >>"$tmp/staged"
}

# workflows pins each step that uses an action of the toolkit, as NAME@REF unquoted, with a comment
# or none after it. It lists each step in $tmp/steps, as NAME PATH:LINE.
workflows() {
    for file in .github/workflows/*.yml .github/workflows/*.yaml; do
        [ -f "$file" ] || continue
        awk -v sha="$sha" -v version="$version" -v changes="$tmp/changes" -v steps="$tmp/steps" '
            BEGIN { uses = "^[ \t]*(-[ \t]+)?uses:[ \t]+zadykian/(toolkit/)?actions/" }
            $0 ~ (uses "[A-Za-z0-9._-]+@[^ \t]+([ \t]*|[ \t]+#.*)$") {
                head = substr($0, 1, index($0, "@") - 1)
                name = head
                sub(uses, "", name)
                print name " " FILENAME ":" FNR >>steps
                line = head "@" sha " # " version
                sub("zadykian/(toolkit/)?actions/", "zadykian/toolkit/actions/", line)
                if (line != $0) {
                    $0 = line
                    sub("^[ \t]+", "", line)
                    print FILENAME ":" FNR ": " line >>changes
                }
            }
            { print }' "$file" >"$tmp/out"
        stage "$file"
    done
}

# released checks that SHA has the action of each step in $tmp/steps.
released() {
    while read -r name at; do
        git -C "$root" cat-file -e "$sha:actions/$name/action.yml" 2>/dev/null ||
            die "$at: $version has no action $name: remove the step, as the release's notes say"
    done <"$tmp/steps"
}

# edit prints settings.json with its source pinned, and exits 2 where it cannot find it. The repo
# is on the one line that names it. The source spans the lines from the last { at or before it to
# the first } at or after it. Its ref is on one of those lines, or else goes after the repo: on a
# line of its own where the repo has one.
edit() {
    awk -v version="$version" -v path="$settings" -v changes="$tmp/changes" '
        BEGIN {
            repo = "\"repo\"[ \t]*:[ \t]*\"zadykian/(toolkit|skills)\""
            ref = "\"ref\"[ \t]*:[ \t]*\"[^\"]*\""
        }
        # set sets the string that ends the match of the pattern p in the line i to v.
        function set(i, p, v,    key) {
            match(text[i], p)
            key = substr(text[i], RSTART, RLENGTH)
            sub(/"[^"]*"$/, "", key)
            text[i] = substr(text[i], 1, RSTART - 1) key v substr(text[i], RSTART + RLENGTH)
        }
        # report prints the line n of the new text, line, to changes.
        function report(n, line) {
            sub(/^[ \t]+/, "", line)
            print path ":" n ": " line >>changes
        }
        { text[NR] = was[NR] = $0 }
        $0 ~ repo { r = NR; repos++ }
        END {
            if (repos != 1) exit 2
            for (s = r; s > 1 && !index(text[s], "{"); s--);
            for (e = r; e < NR && !index(text[e], "}"); e++);
            for (i = s; i <= e; i++) if (text[i] ~ ref) { f = i; refs++ }
            if (refs > 1) exit 2
            set(r, repo, "\"zadykian/toolkit\"")
            if (refs) set(f, ref, "\"" version "\"")
            else {
                match(text[r], repo)
                head = substr(text[r], 1, RSTART + RLENGTH - 1)
                tail = substr(text[r], RSTART + RLENGTH)
                pin = "\"ref\": \"" version "\""
                if (s < r && head ~ /^[ \t]*"repo"/ && tail ~ /^,?[ \t]*$/) {
                    extra = substr(head, 1, index(head, "\"") - 1) pin (tail ~ /,/ ? "," : "")
                    text[r] = head ","
                } else
                    text[r] = head ", " pin tail
            }
            for (i = 1; i <= NR; i++) {
                print text[i]
                if (text[i] != was[i]) report(i, text[i])
                if (i == r && extra != "") { print extra; report(i + 1, extra) }
            }
        }' "$settings"
}

# marketplace pins the source of the toolkit's marketplace in settings.json, and checks with jq
# that the edit changes that source alone. A repository without settings.json gets a note.
marketplace() {
    if [ ! -f "$settings" ]; then
        printf 'tools/pin: no %s, so the workflows alone are pinned\n' "$settings" >&2
        return
    fi
    command -v jq >/dev/null || die "no jq"
    count=$(jq "[$sources] | length" "$settings" 2>/dev/null) || die "$settings is not valid JSON"
    [ "$count" = 1 ] ||
        die "$settings names $count marketplaces of zadykian/toolkit or zadykian/skills, not one"
    edit >"$tmp/out" || die "$settings: no one line holds its source's repo, or its ref"
    jq -S --arg ref "$version" "($sources)"' += {repo: "zadykian/toolkit", ref: $ref}' \
        "$settings" >"$tmp/want"
    if ! jq -S . "$tmp/out" >"$tmp/got" 2>/dev/null || ! cmp -s "$tmp/want" "$tmp/got"; then
        die "the edit of $settings would change more than its source: edit it by hand"
    fi
    stage "$settings"
}

# templates stages each template that SHA holds, as git holds it, at its path in DIR. Each line of
# its table is a template's source in SHA's tree, and its path.
templates() {
    while read -r source path; do
        git -C "$root" cat-file blob "$sha:$source" >"$tmp/out" 2>/dev/null || continue
        stage "$path"
    done <<'EOF'
skills/atomic-commits/pull_request_template.md .github/pull_request_template.md
skills/issue/change.yml .github/ISSUE_TEMPLATE/change.yml
skills/issue/config.yml .github/ISSUE_TEMPLATE/config.yml
EOF
}

main() {
    [ $# = 2 ] || die "usage: tools/pin vX.Y.Z DIR"
    version=$1
    printf '%s\n' "$version" | grep -Eqx "v$semver" || die "$version is not of the form vX.Y.Z"
    root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
    sha=$(git -C "$root" rev-parse -q --verify "refs/tags/$version^{commit}") ||
        die "no tag $version in $root: git fetch --tags, then run it again"
    CDPATH='' cd -- "$2" 2>/dev/null || die "no directory $2"
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' EXIT
    trap 'exit 1' HUP INT TERM
    touch "$tmp/steps" "$tmp/changes" "$tmp/staged"
    workflows
    released
    [ -s "$tmp/steps" ] || [ -f "$settings" ] ||
        die "$2 has no $settings, and no workflow that uses an action of the toolkit"
    marketplace
    templates
    while IFS= read -r file; do
        mkdir -p "${file%/*}"
        cat "$tmp/new/$file" >"$file"
    done <"$tmp/staged"
    [ -s "$tmp/changes" ] || printf '%s pins %s already\n' "$2" "$version" >"$tmp/changes"
    cat "$tmp/changes"
}

main "$@"
