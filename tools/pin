#!/bin/sh
# Pins a repository's actions to one release of the toolkit:
#
#   tools/pin vX.Y.Z DIR
#
# The tag vX.Y.Z of this script's repository names the commit, SHA. In DIR's workflows, each step
# of an action of the toolkit, or of zadykian/actions before it, becomes
# `zadykian/toolkit/actions/NAME@SHA # vX.Y.Z`.
#
# Each edit keeps its file's layout, and a second run changes nothing. Each line it changes goes to
# stdout, as PATH:LINE: TEXT. It needs git.

set -eu

semver='(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)'

# die prints a message of the script's and exits with status 1.
die() {
    printf 'tools/pin: %s\n' "$*" >&2
    exit 1
}

# workflows pins each step that uses an action of the toolkit, as NAME@REF unquoted, with a comment
# or none after it. It lists the steps in $tmp/steps.
workflows() {
    for file in .github/workflows/*.yml .github/workflows/*.yaml; do
        [ -f "$file" ] || continue
        awk -v sha="$sha" -v version="$version" -v changes="$tmp/changes" -v steps="$tmp/steps" '
            BEGIN { uses = "^[ \t]*(-[ \t]+)?uses:[ \t]+zadykian/(toolkit/)?actions/" }
            $0 ~ (uses "[A-Za-z0-9._-]+@[^ \t]+([ \t]*|[ \t]+#.*)$") {
                print FILENAME >>steps
                line = substr($0, 1, index($0, "@") - 1) "@" sha " # " version
                sub("zadykian/(toolkit/)?actions/", "zadykian/toolkit/actions/", line)
                if (line != $0) {
                    $0 = line
                    sub("^[ \t]+", "", line)
                    print FILENAME ":" FNR ": " line >>changes
                }
            }
            { print }' "$file" >"$tmp/out"
        cmp -s "$tmp/out" "$file" || cat "$tmp/out" >"$file"
    done
}

main() {
    [ $# = 2 ] || die "usage: tools/pin vX.Y.Z DIR"
    version=$1
    printf '%s\n' "$version" | grep -Eqx "v$semver" || die "$version is not of the form vX.Y.Z"
    root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
    sha=$(git -C "$root" rev-parse -q --verify "refs/tags/$version^{commit}") ||
        die "no tag $version in $root: git fetch --tags, then run it again"
    CDPATH='' cd -- "$2" 2>/dev/null || die "no directory $2"
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' EXIT
    trap 'exit 1' HUP INT TERM
    touch "$tmp/steps" "$tmp/changes"
    workflows
    [ -s "$tmp/steps" ] || die "$2 has no workflow that uses an action of the toolkit"
    [ -s "$tmp/changes" ] || printf '%s pins %s already\n' "$2" "$version" >"$tmp/changes"
    cat "$tmp/changes"
}

main "$@"
