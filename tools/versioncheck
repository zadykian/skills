#!/bin/sh
# Checks the marketplace's bundles and its version in the work tree, against the last release, as
# tools/lastrelease finds it: the highest tag vX.Y.Z that HEAD reaches.
#
# The marketplace has one version, X.Y.Z, its metadata.version, and each bundle in it gives the
# same, as Claude Code updates a plugin only when its version changes. Each bundle takes its skills
# from the repository's root, source ./ with strict false, and lists each as ./skills/NAME. Each
# directory of skills/ holds SKILL.md and is in one bundle. A hook's script,
# ${CLAUDE_PLUGIN_ROOT}/PATH, is an executable file.
#
# A change need not raise the version, as the commits since the last release may land unreleased,
# but it is never below that release's. Raised, it is the version they call for, as bump says.
#
# Each finding goes to stdout, and any fails the check. Without a marketplace, there is nothing to
# check. It needs git and jq. Run it from the repository's root.

set -eu

marketplace=.claude-plugin/marketplace.json
semver='(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)'

# die prints a message of the script's and exits with status 1.
die() {
    printf 'tools/versioncheck: %s\n' "$*" >&2
    exit 1
}

# finding prints a finding and marks the check failed.
finding() {
    printf '%s\n' "$*"
    status=1
}

# higher succeeds where the version $2 is above the version $1.
higher() {
    [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n 1)" = "$2" ]
}

# entries checks each bundle against the version $1, and the skills each lists.
entries() {
    jq -r --arg v "$1" '.plugins[] | "\(.name)\t\(.source == "./" and .strict == false)\t" +
        "\(.version == $v)\t\([.skills[]?] | join(" "))"' "$marketplace" >"$tmp/entries"
    while IFS="$(printf '\t')" read -r name rooted versioned skills; do
        [ "$rooted" = true ] || finding "$name: its source is not ./ with strict false"
        [ "$versioned" = true ] || finding "$name: its version is not the marketplace's, $1"
        [ -n "$skills" ] || finding "$name: it lists no skill"
        for skill in $skills; do
            case $skill in
            ./skills/*) printf '%s\n' "${skill#./skills/}" >>"$tmp/listed" ;;
            *) finding "$name: the skill $skill is not of ./skills/NAME" ;;
            esac
        done
    done <"$tmp/entries"
}

# skills checks that each skill listed exists, and that each skill is in one bundle.
skills() {
    sort "$tmp/listed" | uniq -d | while read -r skill; do
        printf '%s: more than one bundle lists it\n' "$skill"
    done >"$tmp/twice"
    [ ! -s "$tmp/twice" ] || finding "$(cat "$tmp/twice")"
    while read -r skill; do
        [ -f "skills/$skill/SKILL.md" ] ||
            finding "$skill: listed, but skills/$skill/SKILL.md is missing"
    done <"$tmp/listed"
    for dir in skills/*/; do
        [ -d "$dir" ] || continue
        skill=${dir#skills/}
        skill=${skill%/}
        grep -Fqx "$skill" "$tmp/listed" || finding "$skill: no bundle lists it"
    done
}

# hooks checks that each hook's command is a script of the repository that may run.
hooks() {
    jq -r '[.plugins[].hooks // {} | .[][] | .hooks[].command] | .[]' "$marketplace" |
        while IFS= read -r command; do
            script=${command%% *}
            case $script in
            "\${CLAUDE_PLUGIN_ROOT}/"*) script=${script#"\${CLAUDE_PLUGIN_ROOT}/"} ;;
            *)
                printf 'the hook %s is not of %s/PATH\n' "$command" "\${CLAUDE_PLUGIN_ROOT}"
                continue
                ;;
            esac
            [ -f "$script" ] && [ -x "$script" ] ||
                printf 'the hook %s is no executable file\n' "$script"
        done >"$tmp/hooks"
    [ ! -s "$tmp/hooks" ] || finding "$(cat "$tmp/hooks")"
}

# bump sets next to the version that the commits since the tag $1 call for, and why to the reason.
# A breaking change, by a ! before its header's colon or a BREAKING CHANGE: footer, bumps the
# major, or the minor before 1.0. A feat bumps the minor, and any other commit the patch. It
# leaves out merge commits, as a merge's message may quote a pull request's body, footers included.
bump() {
    major=${1#v} minor=${1#v*.} patch=${1##*.}
    major=${major%%.*} minor=${minor%.*}
    git log --no-merges --format='%h %s' "refs/tags/$1..HEAD" >"$tmp/log"
    breaking=$(sed -En 's/^([0-9a-f]+) [a-z]+(\([^)]*\))?!: .*/\1/p' "$tmp/log" | head -n 1)
    [ -n "$breaking" ] || breaking=$(git log -1 --no-merges --format=%h -E \
        --grep='^BREAKING[ -]CHANGE: ' "refs/tags/$1..HEAD")
    feature=$(sed -En 's/^([0-9a-f]+) feat(\([^)]*\))?: .*/\1/p' "$tmp/log" | head -n 1)
    if [ -n "$breaking" ] && [ "$major" != 0 ]; then
        next=$((major + 1)).0.0 why="$breaking is a breaking change"
    elif [ -n "$breaking" ]; then
        next=0.$((minor + 1)).0 why="$breaking is a breaking change, before 1.0"
    elif [ -n "$feature" ]; then
        next=$major.$((minor + 1)).0 why="$feature is a feature, and no commit is breaking"
    else
        next=$major.$minor.$((patch + 1)) why='no commit is a feature or a breaking change'
    fi
}

# released checks the version $1 against the last release, where there is one.
released() {
    printf '%s\n' "$1" | grep -Eqx "$semver" || return 0
    last=$("$(dirname -- "$0")/lastrelease")
    if [ -z "$last" ] || [ "$1" = "${last#v}" ]; then
        return 0
    elif higher "$1" "${last#v}"; then
        finding "the version $1 is below the last release, $last"
    else
        bump "$last"
        [ "$1" = "$next" ] ||
            finding "the version $1 is not the one the commits since $last call for, $next: $why"
    fi
}

main() {
    command -v jq >/dev/null || die "no jq"
    [ -f "$marketplace" ] || return 0
    jq -e '.plugins | type == "array" and length > 0' "$marketplace" >/dev/null 2>&1 ||
        die "$marketplace lists no bundle"
    status=0
    version=$(jq -r '.metadata.version // ""' "$marketplace")
    printf '%s\n' "$version" | grep -Eqx "$semver" ||
        finding "the marketplace's version, '$version', is not of the form X.Y.Z"
    : >"$tmp/listed"
    entries "$version"
    skills
    hooks
    released "$version"
    return "$status"
}

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
trap 'exit 1' HUP INT TERM
main "$@"
