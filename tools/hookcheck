#!/bin/sh
# Checks the lint plugin's hooks (docs/lint.md), and lib.sh's functions by sourcing it, in
# throwaway repositories, a line a case; any case that fails fails the run. It is hermetic: HOME
# and the git config are the run's own, and an SSH key made for the run signs the commits.

set -u
root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
tmp=$(mktemp -d "${TMPDIR:-/tmp}/hookcheck.XXXXXX") || exit 1
# The hooks pass over a path that is not plain, so the run's directory is plain.
case $tmp in
*[!A-Za-z0-9._/@+-]* | */-*) rmdir "$tmp" && tmp=$(mktemp -d /tmp/hookcheck.XXXXXX) || exit 1 ;;
esac
trap 'rm -rf "$tmp"' EXIT
trap 'exit 1' HUP INT TERM
for name in $(env | sed -n 's/^\(GIT_[A-Za-z0-9_]*\)=.*/\1/p'); do unset "$name"; done
unset CLAUDE_PROJECT_DIR CLAUDE_PLUGIN_DATA MAKEFLAGS MFLAGS MAKELEVEL XDG_CONFIG_HOME
export HOME="$tmp/home" GIT_CONFIG_GLOBAL="$tmp/gitconfig" GIT_CONFIG_NOSYSTEM=1 HOOKCHECK_LOG
mkdir "$HOME" && ssh-keygen -q -t ed25519 -N '' -C hookcheck -f "$tmp/key" </dev/null || exit 1
printf 'hookcheck@example.com namespaces="git" %s\n' "$(cat "$tmp/key.pub")" >"$tmp/signers"
printf '%s\n' '[user]' 'name = hookcheck' 'email = hookcheck@example.com' "signingKey = $tmp/key" \
    '[gpg]' 'format = ssh' '[gpg "ssh"]' "allowedSignersFile = $tmp/signers" '[commit]' \
    'gpgSign = true' '[init]' 'defaultBranch = main' >"$GIT_CONFIG_GLOBAL"
# repo makes a repository at $2, the project by default, its makefile less the lines that start
# with $1. A target logs its run, and fails on a file with BROKEN; all logs a probe of make's.
repo() {
    dir=${2:-$project}
    git init -q "$dir" && grep -v "^${1:-none}" >"$dir/Makefile" <<'EOF' || return 1
log = echo "$@ $(1)" >>"$$HOOKCHECK_LOG"
all: ; +@$(call log,probe)
lint-file: ; @$(call log,$(FILES) @ $(notdir $(CURDIR))) && ! grep -n BROKEN $(FILES)
lint-tree: ; @$(call log,$(BASE)) && ! grep -n BROKEN *.txt
EOF
    echo fine >"$dir/a.txt" && echo ignored.txt >"$dir/.gitignore" && git -C "$dir" add -A &&
        git -C "$dir" commit -q -m init && git -C "$dir" update-ref refs/remotes/origin/main HEAD
}
# commit commits every change of the project, signed, with the git options $@.
commit() { git -C "$project" add -A && git -C "$project" "$@" commit -q -m change; }
# put writes the line $2 to the project's file $1.
put() { mkdir -p -- "$(dirname -- "$project/$1")" && printf '%s\n' "$2" >"$project/$1"; }
# lib runs the command $@ in the project's tree with lib.sh sourced: $status, $tmp/out, $tmp/err.
lib() {
    # shellcheck source=hooks/lib.sh
    (cd -- "$project" && . "$root/hooks/lib.sh" && "$@") >"$tmp/out" 2>"$tmp/err"
    status=$?
}
# hook pipes the JSON $2 into the hook $1 from the project's tree, as Claude Code runs it, with
# $data as CLAUDE_PLUGIN_DATA where set: $status, $tmp/out, $tmp/err.
hook() {
    printf '%s\n' "$2" | (
        cd -- "$project" && export CLAUDE_PROJECT_DIR="$project" || exit 1
        [ -z "$data" ] || export CLAUDE_PLUGIN_DATA="$data"
        exec "$root/hooks/$1"
    ) >"$tmp/out" 2>"$tmp/err"
    status=$?
}
# event pipes the JSON of the session's event $2, with the fields $3, into the hook $1.
event() { hook "$1" "{\"session_id\": \"$session\", \"hook_event_name\": \"$2\", $3}"; }
# edit pipes in PostToolUse's JSON for an Edit of the file $1, or the tool $2's. Its response
# holds a quoted file_path that names another file, which the hook passes over.
edit() {
    key=file_path
    [ "${2:-Edit}" != NotebookEdit ] || key=notebook_path
    event lint-file.sh PostToolUse "\"tool_name\": \"${2:-Edit}\", \"tool_input\": {\"$key\": \
\"$1\"}, \"tool_response\": {\"filePath\": \"$1\", \"text\": \"\\\"file_path\\\": \\\"/no\\\"\"}"
}
# stop pipes in Stop's JSON, with stop_hook_active $1, false by default; started, SessionStart's.
stop() { event lint-tree.sh Stop "\"stop_hook_active\": ${1:-false}"; }
started() { event lint-tree.sh SessionStart '"source": "startup"'; }
# say adds the line $* to the reasons the case fails.
say() { printf '%s\n' "$*" >>"$tmp/why"; }
# exits checks the last run's status, $1.
exits() { [ "$status" -eq "$1" ] || say "status $status, not $1"; }
# holds checks that the last run's stream $1, out or err, holds each text after it, or nothing.
holds() {
    stream=$1 got=$(cat "$tmp/$1") && shift
    [ $# -gt 0 ] || [ -z "$got" ] || say "std$stream holds: $got"
    for text; do grep -qF -- "$text" "$tmp/$stream" || say "std$stream lacks '$text': $got"; done
}
# doubt checks that vouch fails in the project's tree, with the cause $1.
doubt() { lib vouch && exits 1 && holds out "$1"; }
# quiet checks that the last run exited with status 0 and wrote nothing.
quiet() { exits 0 && holds out && holds err; }
# noticed checks that the last run exited with status 0, showing the user that no gate ran as $1.
noticed() { exits 0 && holds err && holds out '{"systemMessage": "lint: no gate ran in ' "$1"; }
# logs checks that the log holds the lines $@ alone, as the targets ran.
logs() {
    want=$(printf '%s\n' "$@") got=$(cat "$HOOKCHECK_LOG")
    [ "$got" = "$want" ] || say "the log holds [$got], not [$want]"
}
# begin starts the case that the line $1 names, in a project directory of its own.
begin() {
    n=$((n + 1)) name=$1 project=$tmp/r$n HOOKCHECK_LOG=$tmp/log$n data=$tmp/data$n session=s$n
    mkdir "$project" && : >"$HOOKCHECK_LOG" && : >"$tmp/why"
}
# verdict prints the case's line: FAIL for the reasons its checks gave, or for a step that failed.
verdict() {
    code=$? && [ "$code" -eq 0 ] || [ -s "$tmp/why" ] || say "a step failed with status $code"
    [ -s "$tmp/why" ] || { printf 'ok    %s\n' "$name" && return; }
    failed=1 && printf 'FAIL  %s: %s\n' "$name" "$(paste -s -d ' ' "$tmp/why")"
}

n=0 failed=0
begin 'field, flag: keys of the JSON alone, not text quoted in a string' &&
    put in '{"k": "a\"b", "t": false, "u": true, "s": "\"k\": \"no\", \"t\": true"}' &&
    lib eval "input=\$(cat in) && field k && ! flag t && flag u" && exits 0 && holds out 'a\"b'
verdict
begin 'plain: [A-Za-z0-9._/@+-] alone, no part starting with -' && lib plain /a/B-9._@+/c &&
    exits 0 && for path in '' 'a b' -a a/-b 'a*b' 'a"b'; do lib plain "$path" && exits 1; done
verdict
begin 'notice: JSON, with quotes and backslashes escaped and control characters gone' &&
    lib notice "$(printf 'a "q" \\ b\tc')" && holds out '{"systemMessage": "a \"q\" \\ bc"}'
verdict
begin 'common: the git common directory, which a linked work tree shares' && repo &&
    git -C "$project" worktree add -q "$project/w" && lib common w && exits 0 &&
    { grep -qx ".*/r$n/\.git" "$tmp/out" || say "the common directory is $(cat "$tmp/out")"; }
verdict
begin 'mentions: a makefile that names a lint target, an untracked *.mk too' && repo lint- &&
    lib mentions && exits 1 && put lint.mk 'lint-tree:' && lib mentions && exits 0
verdict
begin 'vouch: signed commits, and a change outside the gate code' && repo && put b.txt 1 &&
    commit -c commit.gpgSign=true && put a.txt 2 && lib vouch && exits 0 && holds out
verdict
while IFS='|' read -r line steps cause; do
    { begin "vouch: $line" && repo && eval "$steps" && doubt "$cause"; } </dev/null
    verdict
done <<'EOF'
an unsigned commit|put b 1 && commit -c commit.gpgSign=false|lacks a good signature by its author
a commit by another than its key's|put b 1 && commit -c user.email=o@example.com|good signature
a staged change|put a.txt 2 && git -C "$project" add a.txt|the index differs from HEAD
an edited Makefile|put Makefile x|the gate file Makefile differs from HEAD
an untracked file in tools|put tools/new 1|the gate file tools/new is untracked
a lint-gates path edited|put .claude/lint-gates 'c #' && put c 1 && commit && put c 2|file c differs
a lint-gates exclude|put .claude/lint-gates :!Makefile && commit && put Makefile x|Makefile differs
no origin/main|git -C "$project" update-ref -d refs/remotes/origin/main|origin/main is missing
EOF
begin 'has: an explicit rule alone, and the probe runs no recipe' && repo lint-file &&
    echo 'lint-file: X = 1' >>"$project/Makefile" && lib has lint-tree && exits 0 &&
    lib has lint-file && exits 1 && { [ ! -s "$HOOKCHECK_LOG" ] || say 'a recipe ran'; }
verdict
begin 'statedir: in CLAUDE_PLUGIN_DATA, else in the git common directory, made by none' &&
    lib eval "CLAUDE_PLUGIN_DATA=$tmp/d && statedir a-1_B" && holds out "$tmp/d/sessions/a-1_B" &&
    lib eval 'repo=/r && statedir a' && holds out /r/claude-lint/sessions/a &&
    lib statedir a/b && exits 1 && { [ ! -e "$tmp/d" ] || say 'statedir made its directory'; }
verdict
begin 'fresh: a notice once a session, and each one without the state' && mkdir "$tmp/s" &&
    lib eval "state=$tmp/s && fresh m && ! fresh m && fresh n && state= && fresh m" && exits 0
verdict
begin "excerpt: 60 lines of 300 columns, after the failed targets' lines where it cuts" &&
    awk 'BEGIN { print "make: *** x"; while (i++ < 68) print; printf "%0400d\n", 0 }' >"$tmp/l" &&
    lib excerpt "$tmp/l" && holds out 'make: *** x' '[10 lines left out]' &&
    { awk 'length > 300 { exit 1 } END { exit NR != 62 }' "$tmp/out" || say 'not 62 short lines'; }
verdict
begin 'lint-file: passes, silent, and records the tree' && repo && edit "$project/a.txt" &&
    quiet && logs "lint-file a.txt @ r$n" &&
    { [ -s "$data/sessions/$session/trees" ] || say 'no record of the tree'; }
verdict
begin 'lint-file: fails, with exit 2 and its output on stderr' && repo && put a.txt BROKEN &&
    edit "$project/a.txt" && exits 2 && holds out && logs "lint-file a.txt @ r$n" &&
    holds err 'lint: make lint-file FILES=a.txt fails in ' '1:BROKEN'
verdict
begin 'lint-file: a tree not vouched for: a notice, once, and no gate' && repo && put a.txt 2 &&
    git -C "$project" add a.txt && edit "$project/a.txt" &&
    noticed 'as the index differs from HEAD.' && edit "$project/a.txt" && quiet && logs
verdict
begin 'lint-file: no lint-file target: silent' && repo lint-file && put a.txt BROKEN &&
    edit "$project/a.txt" && quiet && logs
verdict
begin 'lint-file: no lint target named, a change staged: silent' && repo lint- && put a.txt 2 &&
    git -C "$project" add a.txt && edit "$project/a.txt" && quiet && logs
verdict
begin 'lint-file: a file of a linked work tree, by its path from that tree' && repo &&
    git -C "$project" worktree add -q "$tmp/w$n" && mkdir "$tmp/w$n/sub" &&
    echo fine >"$tmp/w$n/sub/b.txt" && edit "$tmp/w$n/sub/b.txt" && quiet &&
    logs "lint-file sub/b.txt @ w$n"
verdict
begin "lint-file: NotebookEdit's notebook_path" && repo && edit "$project/a.txt" NotebookEdit &&
    quiet && logs "lint-file a.txt @ r$n"
verdict
begin 'lint-file: an ignored file: silent' && repo && put ignored.txt BROKEN &&
    edit "$project/ignored.txt" && quiet && logs
verdict
begin 'lint-file: a path that is not plain: silent' && repo && put 'a b.txt' BROKEN &&
    edit "$project/a b.txt" && quiet && logs
verdict
begin 'lint-file: a file gone: silent' && repo && edit "$project/gone.txt" && quiet && logs
verdict
begin "lint-file: a file of another repository than the project's: silent" && repo &&
    repo '' "$tmp/o$n" && edit "$tmp/o$n/a.txt" && quiet && logs
verdict
begin 'Stop with stop_hook_active: exit 0, no gate' && repo && put b.txt 1 &&
    edit "$project/b.txt" && stop true && quiet && logs "lint-file b.txt @ r$n"
verdict
begin 'Stop lints a recorded tree, then clears the record' && repo && put b.txt 1 &&
    edit "$project/b.txt" && stop && quiet && stop && quiet &&
    logs "lint-file b.txt @ r$n" 'lint-tree refs/remotes/origin/main'
verdict
begin 'Stop fails on a recorded tree: exit 2 with its output; then Claude may stop' && repo &&
    put b.txt 1 && edit "$project/b.txt" && put c.txt BROKEN && stop && exits 2 &&
    holds err 'lint: make lint-tree BASE=refs/remotes/origin/main fails in ' 'c.txt:1:BROKEN' \
        'fix what this session broke' && stop true && quiet &&
    logs "lint-file b.txt @ r$n" 'lint-tree refs/remotes/origin/main'
verdict
begin 'Stop on a recorded tree not vouched for: a notice, no gate' && repo && put b.txt 1 &&
    edit "$project/b.txt" && git -C "$project" add b.txt && stop &&
    noticed 'as the index differs from HEAD.' && logs "lint-file b.txt @ r$n"
verdict
begin 'Stop skips a tree with no lint-tree target' && repo lint-tree && put b.txt 1 &&
    edit "$project/b.txt" && stop && quiet && logs "lint-file b.txt @ r$n"
verdict
begin 'Stop, without CLAUDE_PLUGIN_DATA: the state in the git common directory' && data= &&
    repo && put b.txt 1 && edit "$project/b.txt" &&
    { [ -s "$project/.git/claude-lint/sessions/$session/trees" ] || say 'no record in .git'; } &&
    stop && quiet && logs "lint-file b.txt @ r$n" 'lint-tree refs/remotes/origin/main'
verdict
begin 'Stop skips a recorded tree equal to origin/main' && repo && edit "$project/a.txt" &&
    stop && quiet && logs "lint-file a.txt @ r$n"
verdict
begin "Stop lints the project's tree, changed through Bash since SessionStart, once" && repo &&
    started && quiet && put b.txt 1 && stop && quiet && stop && quiet &&
    logs 'lint-tree refs/remotes/origin/main'
verdict
begin "Stop skips the project's tree unchanged since SessionStart" && repo && put b.txt 1 &&
    commit -c commit.gpgSign=true && started && stop && quiet && logs
verdict
exit "$failed"
