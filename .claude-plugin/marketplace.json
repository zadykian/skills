{
  "name": "zadykian",
  "description": "Skills and hooks for work in a GitHub repository: plan a change, commit it in small steps, land it by GitHub's merge, keep prose and files short, lint as Claude edits, and keep long sessions lean.",
  "owner": {
    "name": "Aleksandr Zadykian",
    "url": "https://github.com/zadykian"
  },
  "metadata": {
    "version": "6.0.0"
  },
  "plugins": [
    {
      "name": "flow",
      "source": "./",
      "strict": false,
      "version": "6.0.0",
      "description": "From issue to main: plan a change as an issue, commit it in small Conventional Commits and stacked pull requests, and land the stack by GitHub's merge.",
      "author": {
        "name": "Aleksandr Zadykian",
        "url": "https://github.com/zadykian"
      },
      "homepage": "https://github.com/zadykian/toolkit/blob/main/docs/flow.md",
      "repository": "https://github.com/zadykian/toolkit",
      "license": "MIT",
      "category": "development",
      "keywords": ["github", "issues", "conventional-commits", "stacked-prs", "merge-commits"],
      "skills": ["./skills/atomic-commits", "./skills/issue", "./skills/land"]
    },
    {
      "name": "docs",
      "source": "./",
      "strict": false,
      "version": "6.0.0",
      "description": "A writing policy for comments and docs that loads as Claude edits, and a skill that trims files to it, keeping every fact.",
      "author": {
        "name": "Aleksandr Zadykian",
        "url": "https://github.com/zadykian"
      },
      "homepage": "https://github.com/zadykian/toolkit/blob/main/docs/docs.md",
      "repository": "https://github.com/zadykian/toolkit",
      "license": "MIT",
      "category": "productivity",
      "keywords": ["writing", "documentation", "comments", "vale"],
      "skills": ["./skills/trim", "./skills/writing"]
    },
    {
      "name": "lint",
      "source": "./",
      "strict": false,
      "version": "6.0.0",
      "description": "Hooks that run the repository's own lint gates on each file Claude edits and on the branch when it stops, a skill that splits a file over the line cap, and one that keeps vague names and fillers out of new code and prose.",
      "author": {
        "name": "Aleksandr Zadykian",
        "url": "https://github.com/zadykian"
      },
      "homepage": "https://github.com/zadykian/toolkit/blob/main/docs/lint.md",
      "repository": "https://github.com/zadykian/toolkit",
      "license": "MIT",
      "category": "development",
      "keywords": ["lint", "hooks", "make", "refactoring"],
      "skills": ["./skills/banned-terms", "./skills/split-file"],
      "hooks": {
        "SessionStart": [
          {
            "matcher": "startup|resume|clear|fork",
            "hooks": [
              {
                "type": "command",
                "command": "${CLAUDE_PLUGIN_ROOT}/hooks/lint-tree.sh",
                "args": [],
                "timeout": 60,
                "statusMessage": "Noting the work tree"
              }
            ]
          }
        ],
        "PostToolUse": [
          {
            "matcher": "Edit|MultiEdit|Write|NotebookEdit",
            "hooks": [
              {
                "type": "command",
                "command": "${CLAUDE_PLUGIN_ROOT}/hooks/lint-file.sh",
                "args": [],
                "timeout": 300,
                "statusMessage": "Linting the file"
              }
            ]
          }
        ],
        "Stop": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "${CLAUDE_PLUGIN_ROOT}/hooks/lint-tree.sh",
                "args": [],
                "timeout": 900,
                "statusMessage": "Linting the work tree"
              }
            ]
          }
        ]
      }
    },
    {
      "name": "lean",
      "source": "./",
      "strict": false,
      "version": "6.0.0",
      "description": "Cuts the tokens and time of long sessions that fan out subagents and workflows: agents at a fixed model and effort, and a report of what a session costs, by tier, model and cause.",
      "author": {
        "name": "Aleksandr Zadykian",
        "url": "https://github.com/zadykian"
      },
      "homepage": "https://github.com/zadykian/toolkit/blob/main/docs/lean.md",
      "repository": "https://github.com/zadykian/toolkit",
      "license": "MIT",
      "category": "productivity",
      "keywords": ["cost", "tokens", "subagents", "workflows"],
      "skills": ["./skills/cost", "./skills/delegate"],
      "agents": [
        "./lean/agents/scout.md",
        "./lean/agents/runner.md",
        "./lean/agents/checker.md",
        "./lean/agents/implementer.md",
        "./lean/agents/expert.md"
      ],
      "hooks": {
        "PreToolUse": [
          {
            "matcher": "Workflow",
            "hooks": [
              {
                "type": "command",
                "command": "${CLAUDE_PLUGIN_ROOT}/hooks/lean-fanout.sh",
                "args": [],
                "timeout": 10,
                "statusMessage": "Checking the workflow's agents"
              }
            ]
          }
        ]
      }
    }
  ]
}
